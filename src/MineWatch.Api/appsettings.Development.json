{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AWS": {
    "ServiceURL": "http://localhost:4566",
    "Region": "ap-southeast-2"
  },
  "Sqs": {
    "QueueName": "minewatch-telemetry",
    "DLQName": "minewatch-telemetry-dlq",
    "MaxReceiveCount": 3,
    "VisibilityTimeoutSeconds": 30
  },
  "Jwt": {
    "Key": "dev-only-secret-key-min-16-chars"
  }
}
